{
  "$schema": "https://unpkg.com/wrangler@4.152.0/config-schema.json",
  "name": "portifolio",
  "compatibility_date":"2026-10-19",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": true
    },
  },
  "assets": {
    "directory": "."
  }
}